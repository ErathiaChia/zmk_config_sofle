#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&nice_view_spi { cs-gpios = <&pro_micro 0 GPIO_ACTIVE_HIGH>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  `    |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESCAPE      &kp N1  &kp N2   &kp N3    &kp N4     &kp N5                            &kp N6  &kp N7  &kp N8     &kp N9     &kp N0    &kp BACKSPACE
&kp GRAVE       &kp Q   &kp W    &kp E     &kp R      &kp T                             &kp Y   &kp U   &kp I      &kp O      &kp P     &kp DEL
&kp LEFT_SHIFT  &kp A   &kp S    &kp D     &kp F      &kp G                             &kp H   &kp J   &kp K      &kp L      &kp SEMI  &kp SQT
&kp LEFT_GUI    &kp Z   &kp X    &kp C     &kp V      &kp B   &kp C_MUTE    &kp C_MUTE  &kp N   &kp M   &kp COMMA  &kp DOT    &kp FSLH  &kp ENTER
                        &kp TAB  &kp LALT  &kp LCTRL  &mo 1   &kp SPACE     &kp SPACE   &mo 2   &mo 3   &kp MINUS  &kp EQUAL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // | `     |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // | RAISE |   1 |   2 |   3  |   4  |   5  |                   |   6  |   7   |   8   |   9  |    0  |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans  &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_DEC  &kp LA(LC(LG(F3)))    &kp LA(LC(LG(F4)))     &kp LC(LG(LA(F5)))                    &kp LA(LC(LG(F6)))  &kp LA(LC(LG(F7)))  &kp LA(LC(LG(F8)))  &kp LA(LC(LG(F9)))  &kp LA(LC(LG(F10)))  &kp LA(LC(LG(F11)))
&trans  &trans                &trans                &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans                                &trans              &trans              &trans              &kp BACKSLASH       &trans               &kp LA(LC(LG(F12)))
&trans  &trans                &trans                &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans                                &trans              &trans              &trans              &kp PIPE            &trans               &trans
&trans  &trans                &trans                &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans              &trans    &trans  &trans              &trans              &trans              &trans              &trans               &trans
                              &trans                &trans                &trans                 &trans              &trans    &trans  &trans              &trans              &trans              &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Raise {
            // ------------------------------------------------------------------------------------------------------------
            // |BTCLR| BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |     | INS  | PSCR | GUI   |       |      |                | PGUP |      |       |      |       |       |
            // |     | ALT  | CTRL | SHIFT |       | CAPS |                |  <-  |   v  |   ^   |  ->  |  DEL  | BKSPC |
            // |     | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //              |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans         &trans    &trans        &trans     &trans  &trans
&trans  &trans        &kp N1        &kp N2        &kp N3        &trans                          &kp PG_UP      &trans    &kp UP_ARROW  &trans     &trans  &trans
&trans  &trans        &kp N4        &kp N5        &kp N6        &trans                          &kp PAGE_DOWN  &kp LEFT  &kp DOWN      &kp RIGHT  &trans  &bt BT_CLR_ALL
&trans  &trans        &kp N7        &kp N8        &kp N9        &trans        &trans    &trans  &trans         &trans    &trans        &trans     &trans  &trans
                      &kp KP_PLUS   &kp N0        &kp EQUAL     &trans        &trans    &trans  &trans         &trans    &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Super {
            bindings = <
&trans  &kp F1             &kp F2             &kp F3             &kp F4             &kp F5                               &kp F6             &kp F7             &kp F8                 &kp F9               &kp F10               &kp F11
&trans  &kp LA(LC(LG(Q)))  &kp LA(LC(LG(W)))  &kp LA(LC(LG(E)))  &kp LA(LC(LG(R)))  &kp LA(LC(LG(T)))                    &kp LA(LC(LG(Y)))  &kp LA(LC(LG(U)))  &kp LA(LG(LC(I)))      &kp LA(LC(LG(O)))    &kp LA(LC(LG(P)))     &kp F12
&trans  &kp LA(LG(LC(A)))  &kp LG(LA(LC(S)))  &kp LA(LC(LG(D)))  &kp LA(LC(LG(F)))  &kp LA(LC(LG(G)))                    &kp LC(LA(LG(H)))  &kp LA(LC(LG(J)))  &kp LA(LC(LG(K)))      &kp LA(LC(LG(L)))    &kp LA(LC(LG(SEMI)))  &kp LA(LG(LC(APOS)))
&trans  &kp LA(LC(LG(Z)))  &kp LA(LC(LG(X)))  &kp LA(LC(LG(C)))  &kp LA(LC(LG(V)))  &kp LA(LC(LG(B)))  &trans    &trans  &kp LA(LC(LG(N)))  &kp LA(LG(LC(M)))  &kp LA(LG(LC(COMMA)))  &kp LA(LC(LG(DOT)))  &kp LA(LC(LG(FSLH)))  &trans
                           &trans             &trans             &trans             &trans             &trans    &trans  &trans             &trans             &trans                 &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
